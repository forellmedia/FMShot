{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FMShot",
  "version": "0.2.0-beta.1",
  "identifier": "ch.forellmedia.fmshot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FMShot",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Library/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Schnelles Screenshot-Tool",
    "copyright": "© forellmedia.ch",
    "publisher": "forellmedia.ch",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "recommends": [
          "tesseract-ocr",
          "tesseract-ocr-deu"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNzY3NTEwNUNGQTEwQTEKUldTaEVQcGNFSFYydTdmUHZza0NIRXQ1V3FJVXE3Q0t2RUdRMzhuTkgrTUN2bi9Rb1lvcDkwVUoK",
      "endpoints": [
        "https://github.com/forellmedia/FMShot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
